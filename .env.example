# Environment Variables Example

# The base URL for the API. 
# Defaults to '/api/v1' for local development (which uses the Vite proxy) 
# or if the frontend and backend are served from the same domain in production.
# 
# For true cross-domain production environments, uncomment and replace with your backend URL:
# VITE_API_URL=https://api.yourdomain.com/api/v1

VITE_API_URL=/api/v1
